# Rust build artifacts
target/

# Compiled WASM output (tracked separately in releases, not in source)
*.wasm

# Cargo lock — committed to lock all transitive dependency versions
# for reproducible builds on CI with the pinned Rust 1.81.0 toolchain.
# Cargo.lock

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# macOS metadata
.DS_Store

# Environment files — never commit secrets
.env
.env.*
!.env.example

# Coverage reports
coverage/
lcov.info

# Temporary files
*.tmp
*.bak
