# Rust build artifacts
target/

# Compiled WASM output (tracked separately in releases, not in source)
*.wasm

# Cargo lock — excluded for libraries; include for deployed contracts.
# Remove this line if you want reproducible builds pinned on CI.
Cargo.lock

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# macOS metadata
.DS_Store

# Environment files — never commit secrets
.env
.env.*
!.env.example

# Coverage reports
coverage/
lcov.info

# Temporary files
*.tmp
*.bak
